rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isAccountant() {
      return hasRole('accountant');
    }

    function isOfficer() {
      return hasRole('officer');
    }

    function isMember() {
      return hasRole('member');
    }

    function isStaff() {
      return isAdmin() || isAccountant() || isOfficer();
    }

    function isAnyUser() {
      return isStaff() || isMember();
    }

    // ── users collection ─────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isAuthenticated() &&
                    (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── homeowners collection ────────────────────────────────────────────────

    match /homeowners/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── finance / dues collection ────────────────────────────────────────────

    match /dues/{docId} {
      allow read: if isAdmin() || isAccountant();
      allow create, update: if isAdmin() || isAccountant();
      allow delete: if isAdmin();
    }

    // ── payments collection ──────────────────────────────────────────────────

    match /payments/{docId} {
      // Members can read their own payments only
      allow read: if (isMember() && resource.data.uid == request.auth.uid)
                  || isAdmin() || isAccountant();
      allow create, update: if isAdmin() || isAccountant();
      allow delete: if isAdmin();
    }

    // ── announcements ────────────────────────────────────────────────────────

    match /announcements/{docId} {
      allow read: if isAnyUser();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── documents / files metadata ───────────────────────────────────────────

    match /documents/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── notifications collection ─────────────────────────────────────────────
    // Members read their own notifications only.
    // Staff (admin/officer) write notifications to members.

    match /notifications/{docId} {
      allow read: if (isMember() && resource.data.uid == request.auth.uid)
                  || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── complaints collection ────────────────────────────────────────────────
    // Members submit and read their own complaints only.
    // Members cannot update or delete — only staff can.

    match /complaints/{docId} {
      // Read: member reads own, staff reads all
      allow read: if (isMember() && resource.data.uid == request.auth.uid)
                  || isStaff();

      // Create: member can submit, uid field must match their own uid
      allow create: if isMember() &&
                       request.resource.data.uid == request.auth.uid;

      // Update/delete: staff only
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Deny everything else ─────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
