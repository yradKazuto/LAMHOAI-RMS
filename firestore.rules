// firestore.rules
// UPDATED Phase 4 — Officer can read users collection for dashboard stats

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserDoc().role == role;
    }

    function isAdmin()      { return hasRole('admin');      }
    function isAccountant() { return hasRole('accountant'); }
    function isOfficer()    { return hasRole('officer');    }
    function isMember()     { return hasRole('member');     }

    function isStaff() {
      return isAdmin() || isAccountant() || isOfficer();
    }

    function isAnyUser() {
      return isStaff() || isMember();
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
  allow read: if isAuthenticated() &&
                (request.auth.uid == uid ||
                 isAdmin() ||
                 isOfficer() ||
                 isAccountant());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── homeowners / members ──────────────────────────────────────────────────
    match /homeowners/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── payments ──────────────────────────────────────────────────────────────
    match /payments/{docId} {
  allow read: if (isMember() && resource.data.uid == request.auth.uid)
              || isAdmin() || isAccountant();
  allow create, update: if isAdmin() || isAccountant();
  allow delete: if isAdmin();
}
    // ── documents ─────────────────────────────────────────────────────────────
    match /documents/{docId} {
      allow read: if isStaff();
      // Fix 3+4: Officer can upload but only Admin can delete
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── announcements ─────────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if isAnyUser();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── complaints ────────────────────────────────────────────────────────────
    match /complaints/{docId} {
      allow read: if isStaff();
      allow create: if isAnyUser();
      allow update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if isAnyUser();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
