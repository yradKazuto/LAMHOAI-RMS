// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserDoc().role == role;
    }

    function isAdmin()      { return hasRole('admin');      }
    function isAccountant() { return hasRole('accountant'); }
    function isOfficer()    { return hasRole('officer');    }
    function isMember()     { return hasRole('member');     }

    function isStaff() {
      return isAdmin() || isAccountant() || isOfficer();
    }

    function isAnyUser() {
      return isStaff() || isMember();
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated() &&
                    (request.auth.uid == uid ||
                     isAdmin() ||
                     isOfficer() ||
                     isAccountant());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── homeowners / members ──────────────────────────────────────────────────
    match /homeowners/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── payments ──────────────────────────────────────────────────────────────
    match /payments/{docId} {
      allow read: if isAuthenticated() && (
                    resource.data.uid == request.auth.uid
                    || isAdmin()
                    || isAccountant()
                  );
      allow create, update: if isAdmin() || isAccountant();
      allow delete: if isAdmin();
    }

    // ── documents ─────────────────────────────────────────────────────────────
    match /documents/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── announcements ─────────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if isAnyUser();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── complaints ────────────────────────────────────────────────────────────
    match /complaints/{docId} {
      allow read: if isAuthenticated() && (
                    resource.data.uid == request.auth.uid
                    || isStaff()
                  );
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Members can read their own and update isRead on their own only
    // Staff can create, read all, and update all
    match /notifications/{docId} {
      allow read: if isAuthenticated() && (
                    resource.data.uid == request.auth.uid
                    || isStaff()
                  );
      // Member can only update their own notification (for isRead)
      // Staff can update any notification
      allow update: if (isAuthenticated() &&
                       resource.data.uid == request.auth.uid)
                    || isStaff();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    // ── audit_logs ────────────────────────────────────────────────────────────
      match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // audit logs are append-only
    }

// ── settings ──────────────────────────────────────────────────────────────
      match /settings/{docId} {
      allow read: if isAnyUser();
      allow write: if isAdmin();
    }

    // ── lots (Location Mapping) ───────────────────────────────────────────────
    match /lots/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
