// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserDoc().role == role;
    }

    function isAdmin()      { return hasRole('admin');      }
    function isAccountant() { return hasRole('accountant'); }
    function isOfficer()    { return hasRole('officer');    }
    function isMember()     { return hasRole('member');     }

    function isStaff() {
      return isAdmin() || isAccountant() || isOfficer();
    }

    function isAnyUser() {
      return isStaff() || isMember();
    }

    // Admin + accountant: the two roles that manage money.
    function isFinance() {
      return isAdmin() || isAccountant();
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated() &&
                    (request.auth.uid == uid ||
                     isAdmin() ||
                     isOfficer() ||
                     isAccountant());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── homeowners / members ──────────────────────────────────────────────────
    match /homeowners/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── payments ──────────────────────────────────────────────────────────────
    match /payments/{docId} {
      allow read: if isAuthenticated() && (
                    isFinance() ||
                    (resource != null && resource.data.uid == request.auth.uid) ||
                    // Lot-payment mirrors: the member app's co-owner view.
                    // `uid` on a mirror is the buyer's, so a co-owner can only
                    // reach it through the sale they jointly own.
                    (resource != null &&
                     resource.data.type == 'lotPayment' &&
                     get(/databases/$(database)/documents/lot_sales/$(resource.data.saleId)).data.ownerUids.hasAll([request.auth.uid]))
                  );
      allow create, update: if isFinance();
      allow delete: if false; // money is never deleted, only voided
    }

    // ── lot_sales (lot purchase records — cash / installment) ────────────────
    // Written together with lot_payments + lots by SaleService.recordSale
    // (member registration wizard, lot assignment). Money records, so writes
    // stay with finance (admin + accountant); staff can read. Owners (buyer
    // or co-owner) can read their own sale — the member app's My Lots view.
    match /lot_sales/{docId} {
      allow read: if isStaff() ||
                    (isAuthenticated() &&
                     resource != null &&
                     resource.data.ownerUids.hasAll([request.auth.uid]));
      allow create, update: if isFinance();
      allow delete: if isAdmin();
    }

    // ── lot_payments (amortization schedule — one doc per period) ────────────
    // Owners can read the schedule of a sale they own (My Lots screen); the
    // sale's `ownerUids` is the gate.
    match /lot_payments/{docId} {
      allow read: if isStaff() ||
                    (isAuthenticated() &&
                     resource != null &&
                     get(/databases/$(database)/documents/lot_sales/$(resource.data.saleId)).data.ownerUids.hasAll([request.auth.uid]));
      allow create, update: if isFinance();
      allow delete: if false; // schedule rows are never deleted
    }

    // ── lot_ownership (one doc per ownership period) ─────────────────────────
    // LotService.ownershipCollection. Written by LotService.assignOwner /
    // unassignOwner (admin) and by SaleService.recordSale / changeLotOwner
    // (finance). Read by the Lot Ownership History screen (staff).
    match /lot_ownership/{docId} {
      allow read: if isStaff();
      allow create, update: if isFinance();
      allow delete: if false; // ownership periods are closed, never deleted
    }

    // ── lot_ownership_history (previous / current owners of a lot) ───────────
    // One doc per ownership event, written by SaleService.recordSale (first
    // owner), SaleService.changeLotOwner, and LotService.assignOwner /
    // unassignOwner. Admin + accountant can write; staff can read.
    match /lot_ownership_history/{docId} {
      allow read: if isStaff();
      allow create, update: if isFinance();
      allow delete: if isAdmin();
    }

    // ── payment_transactions (cash payment + unapplied credit) ───────────────
    // Written by FirestoreService.recordPaymentWithAllocations. Update is
    // needed because existing credit is cleared (unappliedCredit -> 0) when it
    // is consumed. Never deleted.
    match /payment_transactions/{docId} {
      allow read: if isStaff();
      allow create, update: if isFinance();
      allow delete: if false;
    }

    // ── payment_allocations (how a payment was split across obligations) ─────
    // Append-only record created by recordPaymentWithAllocations.
    match /payment_allocations/{docId} {
      allow read: if isStaff();
      allow create: if isFinance();
      allow update, delete: if false;
    }

    // ── member_ledgers (running balance per member) ───────────────────────────
    // Used by the dues screen (streamMemberLedgers) and updated whenever dues
    // are generated or payments are recorded, so admin AND accountant need
    // write access. Members can read only their own ledger.
    // NOTE: rename `member_ledgers` if your collection uses a different name.
    match /member_ledgers/{docId} {
      allow read: if isAuthenticated() && (
                    isStaff() ||
                    (resource != null && resource.data.uid == request.auth.uid)
                  );
      allow create, update: if isFinance();
      allow delete: if false; // running balance is never deleted
    }

    // ── documents ─────────────────────────────────────────────────────────────
    match /documents/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── announcements ─────────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if isAnyUser();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── complaints ────────────────────────────────────────────────────────────
    match /complaints/{docId} {
      allow read: if isAuthenticated() && (
                    isStaff() ||
                    (resource != null && resource.data.uid == request.auth.uid)
                  );
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── feedback ──────────────────────────────────────────────────────────────
    // Same shape as complaints: a member submits their own (mobile
    // Feedback screen), staff triage it (web-admin Feedback screen, which
    // gates its status buttons to admin/officer).
    match /feedback/{docId} {
      allow read: if isAuthenticated() && (
                    isStaff() ||
                    (resource != null && resource.data.uid == request.auth.uid)
                  );
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Members can read their own and update isRead on their own only
    // Staff can create, read all, and update all
    match /notifications/{docId} {
      allow read: if isAuthenticated() && (
                    isStaff() ||
                    (resource != null && resource.data.uid == request.auth.uid)
                  );
      // Member can only update their own notification (for isRead)
      // Staff can update any notification
      allow update: if (isAuthenticated() &&
                       resource != null && resource.data.uid == request.auth.uid)
                    || isStaff();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    // ── audit_logs ────────────────────────────────────────────────────────────
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // audit logs are append-only
    }

    // ── settings ──────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAnyUser();
      allow write: if isAdmin();
    }

    // ── rate_schedules ────────────────────────────────────────────────────────
    match /rate_schedules/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // ── sales_rate ────────────────────────────────────────────────────────────
    match /sales_rate/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin(); // config doc (create = first save)
    }

    // ── sales_rates (dated per-sqm sale rate table) ─────────────────────────
    // Read is open to any staff role — sale recording and the wizards resolve
    // the rate in force on a date. Only admins write. A row that has not
    // started yet can be removed (typo fixes); past rows are history, so the
    // delete rule double-checks the effective date.
    match /sales_rates/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && request.time < resource.data.effectiveFrom;
    }

    // ── monthly_dues_rates (per-lot monthly rate history) ────────────────────
    // Read is open to any staff role, since both admins and accountants need
    // to resolve the rate in effect for a given month when generating dues
    // (see RateHistoryService.getRateForMonth). Only admins can add a new
    // rate — matches the `settings` write policy above, since this is
    // effectively dues configuration.
    //
    // TEMPORARY (flag for adviser review): delete is allowed for admins so
    // RateHistoryService.deleteScheduledRate() — "remove a scheduled rate
    // that hasn't started yet" in Settings — actually works. The intended
    // long-term design is fully append-only (matches audit_logs below):
    // once decided, either
    //   (a) keep this as-is (admins may delete not-yet-started rates), or
    //   (b) revert to `allow update, delete: if false;` and remove the
    //       "Remove scheduled rate" button + deleteScheduledRate() in
    //       rate_history_service.dart / settings_screen.dart.
    // Deleting an already-started rate is still blocked client-side in
    // deleteScheduledRate(), but note that check is NOT enforced here at
    // the rules level — an admin bypassing the app (e.g. via the Firebase
    // console or a raw API call) could delete a rate that's already in use.
    match /monthly_dues_rates/{docId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /dues_config_history/{docId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── lots (Location Mapping) ───────────────────────────────────────────────
    match /lots/{docId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isOfficer();
      allow update: if isAdmin()
        || (isOfficer()
            && !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['uid', 'ownerName']));
      allow delete: if isAdmin();
    }

    // ── phaseMaps (Location Mapping — additional phase maps) ──────────────────
    match /phaseMaps/{docId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isOfficer();
      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}